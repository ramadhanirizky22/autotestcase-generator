# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override base URL or model
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Server-side only — DO NOT expose to client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI....

# Crawler
# Max time (ms) Playwright waits for a page to settle
CRAWLER_TIMEOUT_MS=20000

# Watch the test flow live
# Set to "false" to run Chromium with a VISIBLE WINDOW so you can watch
# the test execute. Default: headless.
CRAWLER_HEADLESS=true
# Slow motion (ms) between Playwright actions. Use with
# CRAWLER_HEADLESS=false to follow the flow with your eyes.
# Recommended: 0 for production, 300-600 for debugging.
CRAWLER_SLOWMO_MS=0
# Record a Playwright trace.zip per run. Replay step-by-step with:
#   npx playwright show-trace <path>
# (path is shown in the result UI)
CRAWLER_TRACE=false
